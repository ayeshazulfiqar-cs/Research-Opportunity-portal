  "item": [
    {
      "name": "1. Create opportunity (Machine Learning for Crop Disease Detection)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201 Created\", () => pm.response.to.have.status(201));",
              "const j = pm.response.json();",
              "pm.test(\"Has an ID and status Open\", () => { pm.expect(j.id).to.be.a(\"number\"); pm.expect(j.status).to.eql(\"Open\"); });",
              "pm.collectionVariables.set(\"id1\", j.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Machine Learning for Crop Disease Detection\",\n  \"description\": \"Build and evaluate image classifiers that detect common wheat and maize diseases from field photographs.\",\n  \"research_area\": \"Artificial Intelligence\",\n  \"faculty_name\": \"Dr. Ayesha Khan\",\n  \"department\": \"Computer Science\",\n  \"required_skills\": \"Python, PyTorch, Image Processing\",\n  \"available_positions\": 3,\n  \"application_deadline\": \"2026-12-15\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/opportunities",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "opportunities"
          ]
        }
      }
    },
